# Environment Variables

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/scrum_db

# JWT Secret
JWT_SECRET=your-secret-key-here

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# ClickUp Integration
CLICKUP_API_URL=https://api.clickup.com/api/v2
CLICKUP_API_KEY=your-clickup-api-key
CLICKUP_LIST_ID=your-list-id

# Meeting Bot Google Account (Optional)
# If provided, bot will log in with this account before joining meetings
# If not provided, bot will attempt to join as anonymous guest
GOOGLE_BOT_EMAIL=your-bot-email@gmail.com
GOOGLE_BOT_PASSWORD=your-bot-password

# IMPORTANT: Use a dedicated Google Account for the bot, not your personal account
# If using 2FA, you may need to:
# 1. Disable 2FA for this account, OR
# 2. Use an app-specific password, OR
# 3. Complete login manually once (future feature)
